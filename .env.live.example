# Copy to .env.live (git-ignored) and fill in what you use:  cp .env.live.example .env.live
#   docker compose -f docker-compose.live.yml --env-file .env.live --profile paybroker up --build
# The URLs are the LIVE addresses of the apps. The keys and tokens are secrets: they live only here / in your environment,
# never in a workload file, and the simulator never prints or stores them.

# --- where to send (set the ones you use) ---
PAYBROKER_URL=
LLMGW_URL=
PAGERLENS_URL=
TRUSTDESK_URL=
SHOPFRONT_URL=
CITYPULSE_URL=
IDENTITY_URL=

# --- credentials (the variable NAMES are set in the workload files; these are the defaults) ---
PAYBROKER_SECRET_KEY=          # a merchant secret key (sk_test_...) from PayBroker > Merchants
# PAYBROKER_PUBLISHABLE_KEY=   # optional
LLMGW_CLIENT_KEY=              # a client key (lg_...) from the LLM gateway > Clients
PAGERLENS_TOKEN=               # an Ingest token from PagerLens > Settings
SHOPFRONT_TOKEN=              # a ShopFront service token (scope shop); empty: guest shoppers (or a service token with shopfront.api)
TRUSTDESK_CLIENT_TOKEN=        # a TrustDesk token with the Client application scope
CITYPULSE_INGEST_TOKEN=        # an ingest token from CityPulse > Settings

# --- or let the simulator mint tokens from the identity provider (a static token above always wins) ---
# CPSIM_OIDC_ISSUER=
# CPSIM_SERVICE_CLIENT_ID=cpsim-service
# CPSIM_SERVICE_CLIENT_SECRET=      # also used by the identity probe

# --- safety ---
# CPSIM_MAX_RATE=200                # ceiling, items per second, per workload and for all running workloads together
# CPSIM_ALLOW_HTTP_TARGETS=true     # only for local stand-ins reached by name over plain http (e.g. http://host.docker.internal:8000)
