# Copy to .env (git-ignored). Never commit real credentials. LOCAL development only.
# Generate a password:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://cpsim:${POSTGRES_PASSWORD}@127.0.0.1:5436/cpsim

# Where the simulator sends its data (the variables a city or company names in token_env):
# CITYPULSE_INGEST_TOKEN=
# TRUSTDESK_CLIENT_TOKEN=

# Optional: report the simulator's own health to PagerLens (an ingest-scope token created in PagerLens).
# PAGERLENS_URL=http://127.0.0.1:8001
# PAGERLENS_TOKEN=
